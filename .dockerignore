# Dependencies (will be installed in container)
**/node_modules

# Local pnpm content-addressable store. Gitignored, ~1 GB, and never needed in
# the image — the builds install through their own --mount=type=cache store. It
# was missing here, so every `docker build` (CI included) shipped the whole
# thing across as build context before doing any work.
.pnpm-store
**/.pnpm-store

# Build artifacts (will be built in container)
**/.next
**/dist
**/build

# Development files
**/.env
**/.env.local
**/.env.*.local
**/dev-env

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test files
**/*.test.ts
**/*.spec.ts
**/test
**/tests
**/__tests__

# Documentation
*.md
!README.md

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker dev files
docker-compose*.yml
dockflow.json
