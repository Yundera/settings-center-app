# =============================================================================
# settings-center-app dev stack configuration
#
# Usage:
#   cp .env.example .env
#   # edit .env and fill in the FILL_ME_IN values
#   docker compose up -d --build
#
# This single file is consumed twice:
#   1. docker compose substitutes ${DOMAIN} etc. into labels at render time
#      (Compose auto-loads .env from this directory).
#   2. The admin container loads the same file via env_file:, and the inner
#      template-root scripts source it as .pcs.env / .pcs.secret.env /
#      .ynd.user.env (we mount one file under all three names).
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — fill these in (no working defaults)
# -----------------------------------------------------------------------------

# Yundera UID — your account ID from the Yundera platform.
UID=FILL_ME_IN

# Yundera JWT for PCS-orchestrator authentication.
USER_JWT=FILL_ME_IN

# Default password for system/container access (Authelia admin login, SSH).
# `admin` is fine for local dev; pick something stronger for any shared use.
DEFAULT_PWD=admin

# Provider signature for mesh networking — format:
#   https://nsl.sh,<email>,<key>
PROVIDER_STR=FILL_ME_IN

# Email for Caddy / Let's Encrypt. Any valid address works in dev.
EMAIL=you@example.com

# -----------------------------------------------------------------------------
# Defaults — usually fine as-is for local dev
# -----------------------------------------------------------------------------

# `*.localhost` resolves to 127.0.0.1 in every modern browser (RFC 6761), so
# dev-caddy fronts https://admin-dev.localhost and https://auth-dev.localhost
# with no /etc/hosts edits. The `<container>-${DOMAIN}` URL shape is preserved
# for mesh-router-auth's redirect-URI validation (the first label must be
# `admin` or `admin-*`).
DOMAIN=dev.localhost

# CasaOS user inside the simulated PCS.
DEFAULT_USER=pcs

# Template source — `local` skips network sync and uses the bind-mounted
# template-root/. Set to a zip URL (e.g.
# https://github.com/Yundera/template-root/archive/refs/heads/main.zip) to
# test the real download path.
UPDATE_URL=local

# Yundera API base — disabled in dev so ensure-yundera-user-data.sh doesn't
# overwrite DOMAIN/EMAIL/UID with whatever upstream maps for our UID. Uncomment
# only if you specifically want to test that path.
#
# SECOND EFFECT, since the brand work: this variable is also what tells the
# admin app the PCS has an OPERATOR (see src/brand/resolveBrand.ts). Left
# commented, the dev stack renders in self-hosted mode — the Support panel and
# the Provider panel are hidden, and fetched SSH keys show the neutral
# "TLS-verified" tone instead of "Trusted source". That is correct behaviour,
# not a bug. Uncomment to exercise the operator path, accepting the
# DOMAIN/EMAIL/UID overwrite above.
#YUNDERA_API=https://app.yundera.com/service/pcs
