# =============================================================================
# settings-center-app dev stack configuration
#
# Usage:
#   cp .env.example .env
#   # the defaults below boot as-is; edit only if you want different values
#   docker compose up -d --build
#   # browse https://admin-dev.localhost
#
# This single file is consumed twice:
#   1. Compose substitutes ${DOMAIN} etc. into labels at render time (Compose
#      auto-loads .env from this directory).
#   2. pcs-host writes it out as .pcs.env / .pcs.secret.env / .ynd.user.env, and
#      the template-root scripts source all three.
# =============================================================================

# -----------------------------------------------------------------------------
# Identity / credentials
# -----------------------------------------------------------------------------

# Seeds the Authelia `admin` account on first boot (ensure-authelia.sh hashes it
# with argon2 into users_database.yml). This is the password you log in with.
# Only re-read on a fresh `auth_data` volume — Authelia owns it afterwards.
DEFAULT_PWD=admin

# Recovery address for the `admin` account. ensure-authelia.sh re-stamps
# users_database.yml from this on every run, which is why the Account panel
# refuses to edit the operator's email — change it here instead.
EMAIL=dev@example.com

# Yundera platform values. Stubs are fine: upstream calls fail in the logs but
# nothing in the dashboard depends on them locally.
UID=devuser
USER_JWT=stub-jwt-not-valid
PROVIDER_STR=https://nsl.sh,dev@local,stubkey

# -----------------------------------------------------------------------------
# Defaults — usually fine as-is
# -----------------------------------------------------------------------------

# `*.localhost` resolves to 127.0.0.1 in every modern browser (RFC 6761), so the
# stack is reachable with no /etc/hosts edits. Services are published as
# SIBLINGS of this name — admin-dev.localhost, auth-dev.localhost,
# local-auth-dev.localhost — which is the `<service>-<domain>` shape
# auth-registrar validates redirect URIs against.
DOMAIN=dev.localhost

# Ongoing template sync (ensure-template-sync.sh). `local` keeps whatever
# bootstrap.sh laid down from your working copy; anything else re-downloads and
# would overwrite your local template edits on the next self-check tick.
#
# NOTE: the first-boot template source is NOT configurable here any more. It is
# the bind-mount of ../../../template-root/root in docker-compose.yml — the
# whole point being that unpushed template changes show up in the stack.
UPDATE_URL=local

# Operator/control-plane base URL. Left unset on purpose:
#   - ensure-yundera-user-data.sh would otherwise overwrite DOMAIN/EMAIL/UID
#     with whatever upstream maps for our UID;
#   - ensure-dex.sh would try to register a "Yundera Login" connector against
#     it (it skips cleanly when unset, leaving only the Local Account connector,
#     which is what you want to exercise locally);
#   - src/brand/resolveBrand.ts uses its presence to decide the PCS has an
#     operator, so leaving it unset renders the self-hosted brand and hides the
#     Support and Provider panels. That is correct behaviour, not a bug.
#OPERATOR_API=https://app.yundera.com/service/pcs
