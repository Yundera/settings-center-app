# Dev variant of template-root/root/Caddyfile.
#
# The `(gateway_tls)` snippet now serves the certificate at /certs, exactly as
# prod does, rather than `tls internal`. On a real PCS that cert comes from the
# mesh-router gateway; here bootstrap.sh mints it from a local CA before any
# dependent container starts.
#
# That is not just fidelity. Caddy's internal CA is created lazily on first
# issuance — i.e. after Dex has already started and attempted its Authelia
# back-channel — so `tls internal` left Dex unable to verify the chain on a cold
# boot, and no service ordering could fix it.
#
# To lose the browser warning, trust the dev CA once:
#   docker compose cp pcs-host:/certs/ca.pem ./dev-ca.pem
#
# Dropped from prod: the sslip.io / nip.io / DEFAULT_SERVICE root blocks and the
# Cloudflare-worker Host restoration, none of which have meaning locally.
{
    log {
        output stdout
        format console
    }
    email {$PCS_EMAIL}
}

(gateway_tls) {
    tls /certs/cert.pem /certs/key.pem
}
