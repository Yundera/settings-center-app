# PCS Configuration Environment Variables
# This file contains general PCS configuration that is neither secret nor user-specific
# Used for system-wide settings and operational parameters

DEFAULT_USER=pcs

# Template Repository Configuration
# Direct zip file URL to download template updates from.
# Must be a valid zip file URL ending with .zip
# Examples:
# - https://github.com/Yundera/template-root/archive/refs/heads/main.zip
# - https://github.com/your-fork/template-root/archive/refs/heads/custom-branch.zip
# If not specified, defaults to: https://github.com/Yundera/template-root/archive/refs/heads/main.zip
#UPDATE_URL=https://github.com/Yundera/template-root/archive/refs/heads/main.zip
UPDATE_URL=local

# Yundera API Configuration
# Full URL for Yundera user API endpoint
# Used for fetching user data and authentication
# If not specified, the API call will be skipped
#
# DISABLED FOR DEV: ensure-yundera-user-data.sh would call this endpoint and
# overwrite DOMAIN/EMAIL/UID with whatever the upstream maps for our UID
# (e.g. UID EkGcLEimm9TIa5TdketObbnbRQ52 → wisera.inojob.com), breaking the
# localhost-routable DOMAIN we set in test-ynd.user.env.
#YUNDERA_API=https://app.nasselle.com/service/pcs
#YUNDERA_API=http://host.docker.internal:8194