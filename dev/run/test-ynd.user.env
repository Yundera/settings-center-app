# User-specific environment variables (for testing migrations - should be populated by migrations)
# UID will be migrated from old .env
UID=EkGcLEimm9TIa5TdketObbnbRQ52
# Localhost-routable via nip.io: every label `<x>-127-0-0-1.nip.io` resolves to 127.0.0.1.
# This lets the dev caddy front https://admin-127-0-0-1.nip.io and
# https://auth-127-0-0-1.nip.io without /etc/hosts edits, while keeping the
# `<container>-${DOMAIN}` URL shape that mesh-router-auth's PTR validation expects.
DOMAIN=127-0-0-1.nip.io
EMAIL=pierre.henri@aptero.co
